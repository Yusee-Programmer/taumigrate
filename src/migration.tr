# taumigrate.migration — Migration: one versioned revision in the
# migration GRAPH, plus build_chain()/heads() which validate it and
# order it into a topological (root-to-heads) sequence the runner
# applies/reverts in.
#
# Modeled on Alembic's own revision model: each migration carries its own
# `revision` id and the `down_revisions` (parent(s)) it was written
# against, rather than relying on filename/timestamp ordering the way
# Rails/Django migrations do -- this is what lets autogenerate insert a
# new migration on top of "whatever the current head is" without the
# caller having to know or maintain a separate ordering.
#
# **The graph, not a chain**: a migration normally has exactly ONE parent
# (`Migration.init`, the common case -- a linear step forward). Two or
# more migrations can share the SAME parent (a BRANCH/fork -- e.g. two
# feature branches both built on top of the same released revision,
# developed independently); a migration can also have TWO OR MORE
# parents (`Migration.init_merge` -- a MERGE, joining two branches back
# into one, Alembic's own exact mechanism for this). The result is a DAG
# with a single root but potentially several simultaneous HEADS until
# merged. `build_chain` still returns a flat, topologically-valid
# `Vec[Migration]` (a linear order respecting every dependency) even when
# the underlying graph branches -- see `heads()` for the actual set of
# current head revisions, and runner.tr's multi-head-aware operations
# (`current_revisions`, `upgrade_to_heads`, `downgrade_head`) for working
# with more than one branch at once. The single-parent, single-head
# functions this package shipped with first (`Migration.init`,
# `current_revision`, `upgrade_to_head`, `downgrade_one`, `downgrade_to`)
# keep working completely unchanged for the common, non-branching case.
#
# Deliberately NOT supported: multiple independent ROOTS (two migration
# sets sharing no common ancestor at all) -- see `build_chain`'s
# MIGRATION_MULTI_ROOT below. That's a different problem (two unrelated
# histories accidentally combined) from branching FROM a shared root,
# which this file fully supports. Also not supported: named branch
# labels (Alembic's `branch_labels`/`@branchname` addressing) -- a
# caller identifies a specific head by its OWN revision id instead (see
# `downgrade_head`); no concrete need for labels has come up.

from db_error import DbError
from std.core.vec import Vec
from std.core.map import Map
from std.sys.time import Clock

pub class Migration:
    pub revision:       str
    pub down_revision:  str          # convenience: down_revisions[0], or "" for a root or a merge migration -- see down_revisions for the canonical field
    pub down_revisions: Vec[str]     # this migration's parent(s): 0 entries (the graph's root), 1 (the ordinary case), 2+ (a MERGE migration joining branches back into one)
    pub message:          str
    pub up:                  def(str) -> Vec[str]   # dialect -> SQL statements to apply, in order
    pub down:                  def(str) -> Vec[str]   # dialect -> SQL statements to reverse it, in order

extend Migration:
    pub def init(revision: str, down_revision: str, message: str, up: def(str) -> Vec[str], down: def(str) -> Vec[str]) -> Migration:
        mut m = Migration()
        m.revision = revision
        m.down_revision = down_revision
        m.down_revisions = Vec[str].init(1)
        if down_revision != "": m.down_revisions.push(down_revision)
        m.message = message
        m.up = up
        m.down = down
        return m

    # A MERGE migration: joins two or more existing branch heads back
    # into a single one. `down_revisions` must have 2+ entries, each an
    # existing revision in the set this migration is used with. `up`/
    # `down` are typically empty statement lists (Alembic's own
    # convention -- a merge migration exists to record the graph join,
    # not to run DDL), though nothing stops a real migration from doing
    # both at once.
    pub def init_merge(revision: str, down_revisions: Vec[str], message: str, up: def(str) -> Vec[str], down: def(str) -> Vec[str]) -> Migration:
        mut m = Migration()
        m.revision = revision
        m.down_revisions = down_revisions
        m.down_revision = ""
        if down_revisions.len > 0: m.down_revision = down_revisions.get(0)
        m.message = message
        m.up = up
        m.down = down
        return m

# A fresh, effectively-unique revision id for a newly-authored migration
# (hand-written or autogenerated) -- an epoch-millisecond timestamp, which
# is both naturally unique for the realistic use case (a human or a script
# running `autogenerate` interactively, not a high-concurrency generator)
# and, unlike Alembic's random 12-hex-char ids, incidentally readable as
# "when was this migration created".
pub def new_revision_id() -> str:
    return Clock.now_ms().to_str()

pub class MigrationGraph:
    pub by_revision: Map[str, Migration]
    pub children_of: Map[str, Vec[str]]   # revision -> every OTHER migration built directly on top of it (0, 1, or 2+ children -- 2+ is a branch point)
    pub ordered:      Vec[Migration]        # a topologically-valid order (every migration after all of its own parents)

# Validate a flat Vec[Migration] as a single-root DAG and produce a
# topological order for it. Shared by `build_chain`/`heads`. Raises
# DbError (never a silent best-effort guess) on:
#   - MIGRATION_DUP_REVISION: two migrations share the same revision id
#   - MIGRATION_NO_ROOT:      migrations given but none has an empty down_revisions
#   - MIGRATION_MULTI_ROOT:   more than one migration has an empty
#     down_revisions -- multiple DISCONNECTED migration sets, not a
#     branch (a branch is two+ migrations sharing the SAME non-empty
#     parent, which is fully supported and not an error)
#   - MIGRATION_ORPHAN: a down_revisions entry naming nothing in the set
#   - MIGRATION_CYCLE:  a down_revisions cycle (or any other reason some
#     migrations are never reachable once the checks above pass)
def _build_graph(migrations: Vec[Migration]) throws DbError -> MigrationGraph:
    mut g = MigrationGraph()
    g.by_revision = Map[str, Migration].init(migrations.len)
    g.children_of = Map[str, Vec[str]].init(migrations.len)
    g.ordered = Vec[Migration].init(migrations.len)
    if migrations.len == 0: return g

    mut in_degree = Map[str, int].init(migrations.len)
    mut roots_count = 0
    mut i = 0
    while i < migrations.len:
        mut m = migrations.get(i)
        if g.by_revision.contains(m.revision):
            raise(DbError.init("MIGRATION_DUP_REVISION", "duplicate migration revision '" + m.revision + "'"))
        g.by_revision.insert(m.revision, m)
        in_degree.insert(m.revision, m.down_revisions.len)
        if m.down_revisions.len == 0: roots_count = roots_count + 1
        i = i + 1

    if roots_count == 0:
        raise(DbError.init("MIGRATION_NO_ROOT", "no migration has an empty down_revisions (nothing to start the graph from)"))
    if roots_count > 1:
        raise(DbError.init("MIGRATION_MULTI_ROOT", "more than one migration has an empty down_revisions (" + roots_count.to_str() + " roots) -- multiple disconnected migration sets are not supported (branching FROM a shared root is -- see this file's header comment)"))

    mut i2 = 0
    while i2 < migrations.len:
        mut m2 = migrations.get(i2)
        mut j = 0
        while j < m2.down_revisions.len:
            mut parent = m2.down_revisions.get(j)
            if not g.by_revision.contains(parent):
                raise(DbError.init("MIGRATION_ORPHAN", "migration '" + m2.revision + "' has a down_revision '" + parent + "', which is not in the given set"))
            mut kids: Vec[str] = Vec[str].init(2)
            if g.children_of.contains(parent): kids = g.children_of.get(parent)
            kids.push(m2.revision)
            g.children_of.insert(parent, kids)
            j = j + 1
        i2 = i2 + 1

    # Kahn's algorithm: repeatedly take every not-yet-placed migration
    # whose in-degree (remaining unsatisfied parents) has hit 0, in
    # ORIGINAL input order among ties, for a deterministic result.
    mut done = Map[str, bool].init(migrations.len)
    mut remaining = migrations.len
    while remaining > 0:
        mut progressed = false
        mut k = 0
        while k < migrations.len:
            mut mk = migrations.get(k)
            if not done.contains(mk.revision) and in_degree.get(mk.revision) == 0:
                g.ordered.push(mk)
                done.insert(mk.revision, true)
                remaining = remaining - 1
                progressed = true
                if g.children_of.contains(mk.revision):
                    mut kids2 = g.children_of.get(mk.revision)
                    mut kj = 0
                    while kj < kids2.len:
                        mut kid_rev = kids2.get(kj)
                        in_degree.insert(kid_rev, in_degree.get(kid_rev) - 1)
                        kj = kj + 1
            k = k + 1
        if not progressed:
            raise(DbError.init("MIGRATION_CYCLE", "migration graph is broken: " + g.ordered.len.to_str() + " of " + migrations.len.to_str() + " migrations are reachable -- check for a down_revision cycle among the rest"))
    return g

# Order a flat Vec[Migration] into A topologically-valid sequence (every
# migration appears after all of its own parents) -- for a plain, non-
# branching chain, this is the single unambiguous root-to-head order; for
# a branching graph, it's ONE valid interleaving of the independent
# branches (deterministic -- see `_build_graph`'s own comment -- but not
# the only mathematically valid one). See this file's header comment for
# the full account of what's supported.
pub def build_chain(migrations: Vec[Migration]) throws DbError -> Vec[Migration]:
    mut g = _build_graph(migrations)?
    return g.ordered

# The graph's current HEAD revisions -- migrations nobody else is built
# on top of. Exactly one for a plain linear chain; two or more when
# there are unmerged branches. Validates the same way `build_chain` does.
pub def heads(migrations: Vec[Migration]) throws DbError -> Vec[str]:
    mut g = _build_graph(migrations)?
    mut out: Vec[str] = Vec[str].init(2)
    mut i = 0
    while i < g.ordered.len:
        mut rev = g.ordered.get(i).revision
        if not g.children_of.contains(rev): out.push(rev)
        i = i + 1
    return out
