# taumigrate.migration — Migration: one versioned revision in the chain,
# plus build_chain() which orders a flat Vec[Migration] into the single
# linear root-to-head sequence the runner applies/reverts in.
#
# Modeled on Alembic's own revision model: each migration carries its own
# `revision` id and the `down_revision` (parent) it was written against,
# rather than relying on filename/timestamp ordering the way Rails/Django
# migrations do -- this is what lets `--autogenerate` insert a new
# migration on top of "whatever the current head is" without the caller
# having to know or maintain a separate ordering.
#
# Scope: a single linear chain only (one root, one head) -- Alembic's own
# branch/merge support (multiple heads merged back into one) is real but
# meaningfully more complex (a DAG, not a list) and nothing in this
# project has a concrete need for it yet. `build_chain` raises a DbError
# naming the problem (multiple heads, multiple roots, a broken/orphan
# `down_revision`, or a cycle) rather than silently guessing an order.

from db_error import DbError
from std.core.vec import Vec
from std.core.map import Map
from std.sys.time import Clock

pub class Migration:
    pub revision:      str
    pub down_revision: str   # "" = this migration is the chain's root (base)
    pub message:        str
    pub up:               def(str) -> Vec[str]   # dialect -> SQL statements to apply, in order
    pub down:               def(str) -> Vec[str]   # dialect -> SQL statements to reverse it, in order

extend Migration:
    pub def init(revision: str, down_revision: str, message: str, up: def(str) -> Vec[str], down: def(str) -> Vec[str]) -> Migration:
        mut m = Migration()
        m.revision = revision
        m.down_revision = down_revision
        m.message = message
        m.up = up
        m.down = down
        return m

# A fresh, effectively-unique revision id for a newly-authored migration
# (hand-written or autogenerated) -- an epoch-millisecond timestamp, which
# is both naturally unique for the realistic use case (a human or a script
# running `autogenerate` interactively, not a high-concurrency generator)
# and, unlike Alembic's random 12-hex-char ids, incidentally readable as
# "when was this migration created".
pub def new_revision_id() -> str:
    return Clock.now_ms().to_str()

# Order a flat Vec[Migration] into its single linear root-to-head chain by
# following `down_revision` (parent) links forward. Raises DbError (not a
# silent best-effort order) on:
#   - MIGRATION_MULTI_ROOT: more than one migration with down_revision==""
#   - MIGRATION_NO_ROOT:    migrations given but none has down_revision==""
#   - MIGRATION_ORPHAN:     a down_revision that names no migration in the set
#   - MIGRATION_MULTI_HEAD: more than one migration is nobody's down_revision
#   - MIGRATION_CYCLE:      following the chain never reaches every migration
#     (the only way that happens once multi-root/orphan/multi-head are
#     already ruled out is a cycle among the remainder)
pub def build_chain(migrations: Vec[Migration]) throws DbError -> Vec[Migration]:
    mut ordered: Vec[Migration] = Vec[Migration].init(migrations.len)
    if migrations.len == 0: return ordered

    mut by_revision = Map[str, Migration].init(migrations.len)
    mut children_of = Map[str, str].init(migrations.len)   # down_revision -> the ONE revision built on it
    mut roots: Vec[str] = Vec[str].init(2)
    mut i = 0
    while i < migrations.len:
        mut m = migrations.get(i)
        if by_revision.contains(m.revision):
            raise(DbError.init("MIGRATION_DUP_REVISION", "duplicate migration revision '" + m.revision + "'"))
        by_revision.insert(m.revision, m)
        if m.down_revision == "":
            roots.push(m.revision)
        else:
            if children_of.contains(m.down_revision):
                raise(DbError.init("MIGRATION_MULTI_HEAD", "revision '" + m.down_revision + "' has two migrations built on it ('" + children_of.get(m.down_revision) + "' and '" + m.revision + "') -- branching chains are not supported"))
            children_of.insert(m.down_revision, m.revision)
        i = i + 1

    if roots.len == 0:
        raise(DbError.init("MIGRATION_NO_ROOT", "no migration has down_revision == \"\" (nothing to start the chain from)"))
    if roots.len > 1:
        raise(DbError.init("MIGRATION_MULTI_ROOT", "more than one migration has down_revision == \"\" (" + roots.len.to_str() + " roots) -- branching chains are not supported"))

    # Walk forward from the root via children_of. `cur` is always either
    # the root (verified present above) or a value from children_of,
    # which only ever holds `m.revision` for a migration already inserted
    # into by_revision in the loop above -- so `cur` is always resolvable
    # here; no separate existence check is needed mid-walk.
    mut cur = roots.get(0)
    while cur != "":
        ordered.push(by_revision.get(cur))
        if children_of.contains(cur):
            cur = children_of.get(cur)
        else:
            cur = ""

    if ordered.len != migrations.len:
        # Some migrations were never reached from the root. Distinguish
        # WHY: if any unreached migration's down_revision doesn't name a
        # real revision at all, that's a dangling reference (orphan) --
        # report that specifically, since it's the more actionable
        # diagnosis. Otherwise every unreached migration's down_revision
        # DOES resolve to a real revision, just not one the root walk
        # ever passed through -- a genuine cycle (or a second,
        # disconnected sub-chain sharing no root with the first).
        mut oi = 0
        while oi < migrations.len:
            mut om = migrations.get(oi)
            if om.down_revision != "" and not by_revision.contains(om.down_revision):
                raise(DbError.init("MIGRATION_ORPHAN", "migration '" + om.revision + "' has down_revision '" + om.down_revision + "', which is not in the given set"))
            oi = oi + 1
        raise(DbError.init("MIGRATION_CYCLE", "migration chain is broken: " + ordered.len.to_str() + " of " + migrations.len.to_str() + " migrations are reachable from the root -- check for a down_revision cycle (or a second, disconnected sub-chain) among the rest"))

    return ordered
