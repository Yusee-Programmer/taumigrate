# taumigrate — an Alembic-equivalent migrations toolkit for tauorm.
#
#   from taumigrate import Migration, new_revision_id, heads
#   from taumigrate import ensure_version_table, current_revision, current_revisions, pending_migrations
#   from taumigrate import upgrade_to_head, upgrade_to_heads, upgrade_one, downgrade_one, downgrade_to, downgrade_head
#   from taumigrate import introspect_schema, introspected_to_table
#   from taumigrate import SchemaOp, diff_schema
#   from taumigrate import GeneratedSql, generate_migration_sql
#
# Hand-written migration:
#
#   mut m = Migration.init("1", "", "create users", def(dialect: str) -> Vec[str]:
#       mut s: Vec[str] = Vec[str].init(1)
#       s.push("CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT NOT NULL)")
#       return s
#   , def(dialect: str) -> Vec[str]:
#       mut s: Vec[str] = Vec[str].init(1)
#       s.push("DROP TABLE users")
#       return s
#   )
#   mut applied = upgrade_to_head[SqliteConnection, SqliteResultSet](engine, "sqlite", migrations)?
#
# Branching + merging (two migrations built on the SAME parent, then one
# migration built on BOTH of them -- see migration.tr's header comment
# for the full DAG model):
#
#   mut b1 = Migration.init("2a", "1", "feature A", ...)
#   mut b2 = Migration.init("2b", "1", "feature B", ...)
#   mut parents: Vec[str] = Vec[str].init(2)
#   parents.push("2a"); parents.push("2b")
#   mut mrg = Migration.init_merge("3", parents, "merge A and B", noop_up, noop_down)
#   mut applied = upgrade_to_heads[SqliteConnection, SqliteResultSet](engine, "sqlite", migrations)?
#
# Autogenerate (diff a live DB's introspected schema against tauorm's
# MetaData, get back ready-to-use up/down SQL):
#
#   mut live = introspect_schema[SqliteConnection, SqliteResultSet](engine, "sqlite")?
#   mut gen  = generate_migration_sql(md, live, "sqlite")
#   mut m2   = Migration.init(new_revision_id(), current_head_revision, "autogenerated",
#                              def(_: str) -> Vec[str]: return gen.up,
#                              def(_: str) -> Vec[str]: return gen.down)
#
# See PROPOSAL.md for the full design (the migration DAG / branching
# model, composite primary keys, column rename detection, SQLite's
# rebuild-dance for column changes, and what's deliberately deferred).

from migration import Migration, new_revision_id, build_chain, heads
from introspect import IntrospectedColumn, IntrospectedTable, introspect_schema, introspect_sqlite, introspect_postgres, introspected_to_table, introspected_column_to_column
from diff import SchemaOp, diff_schema, types_match, base_type
from autogen import GeneratedSql, generate_migration_sql
from runner import ensure_version_table, current_revision, current_revisions, set_revision, set_heads, pending_migrations, upgrade_to_head, upgrade_to_heads, upgrade_one, downgrade_one, downgrade_to, downgrade_head
